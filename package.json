{
  "name": "novel-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings --ignore-pattern=packages/**/lib/** .",
    "test": "vitest run",
    "test:focused": "vitest run packages/novel-project/tests"
  },
  "devDependencies": {
    "@novel-agent/novel-planning": "workspace:*",
    "@novel-agent/novel-writing": "workspace:*",
    "@novel-agent/novel-memory": "workspace:*",
    "@novel-agent/novel-review": "workspace:*",
    "@novel-agent/novel-workbench": "workspace:*",
    "@types/node": "22.20.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
