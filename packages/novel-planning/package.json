{
  "name": "@novel-agent/novel-planning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Planning roles and accepted-revision plan reads; planning tools are still being migrated.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["cordis.patch.yml", "lib/index.js", "lib/index.d.ts", "lib/projection.js", "lib/projection.d.ts", "lib/schema.js", "lib/schema.d.ts"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/novel-project/tests/novel-project.spec.ts packages/novel-project/tests/novel-project-narrative.spec.ts packages/novel-project/tests/novel-project-result-packet-remote.integration.spec.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "zod": "4.4.3"
  },
  "peerDependencies": { "@novel-agent/novel-project": "workspace:*" }
}
